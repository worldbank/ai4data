  "@type": "sc:Dataset",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "LFS occupation coding (example)",
  "description": "Job descriptions from the labour force survey with ISCO-08 codes assigned by trained coders, for training and evaluating automatic occupation coders.",
  "url": "https://stats.example/datasets/lfs-occupation-ml",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "version": "1.0.0",
  "datePublished": "2026-10-09",
  "citeAs": "National Statistics Office (example). 2026. LFS occupation coding (example), version 1.0.0. https://stats.example/datasets/lfs-occupation-ml",
  "creator": {
    "@type": "Organization",
    "name": "National Statistics Office (example)"
  },
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "data-file",
      "name": "lfs_occupation_ml.csv",
      "description": "The data, one record per row.",
      "contentUrl": "lfs_occupation_ml.csv",
      "encodingFormat": "text/csv",
      "sha256": "e6b0b1fd6a3230680e3598208f4c08b1b25e41873cc0d050009bd6f858264972"
    },
    {
      "@type": "cr:FileObject",
      "@id": "splits-file",
      "name": "splits.csv",
      "description": "The split assignment, one row per record.",
      "contentUrl": "splits.csv",
      "encodingFormat": "text/csv",
      "sha256": "bbd83fc32f8f6d7fb90ae1195140e0cc934945e813c209153915736f80a08ce6"
    }
  ],
